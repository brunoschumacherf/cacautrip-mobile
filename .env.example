EXPO_PUBLIC_API_URL=http://localhost:3000

# Opcional: endereço público do WebSocket; por padrão deriva de EXPO_PUBLIC_API_URL.
# EXPO_PUBLIC_WS_URL=ws://localhost:3000/cable

# Opcional: sobrescreve o retorno detectado automaticamente no acesso Google.
# Precisa estar na lista GOOGLE_APP_REDIRECT_URIS do Rails.
# EXPO_PUBLIC_GOOGLE_REDIRECT_URI=cacautrip://google-callback
# Mapas: opcional, para um provedor autorizado contratado pela aplicação.
# Configure os dois valores juntos, seguindo a licença e os limites do provedor.
# Sem configuração, utiliza os tiles públicos padrão do OpenStreetMap.
# EXPO_PUBLIC_MAP_TILE_URL=https://seu-provedor.example/{z}/{x}/{y}.png
# EXPO_PUBLIC_MAP_TILE_ATTRIBUTION=Créditos exigidos pelo seu provedor
